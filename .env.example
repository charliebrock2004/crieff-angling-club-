# =============================================================================
# Crieff Angling Club — environment variables
# Copy to .env.local for development. In production set these in Vercel
# (Project → Settings → Environment Variables). NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser; everything else is
# server-only.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Public URL, no trailing slash. Used for emails, QR codes, Stripe redirects, SEO.
NEXT_PUBLIC_SITE_URL=https://www.crieffanglingclub.org.uk

# --- Database (Supabase Postgres) ------------------------------------------------
# Server-only connection used by the app. On Vercel use the Supabase
# *transaction pooler* URI (port 6543): Project → Connect → Transaction pooler.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
# Optional: max connections per serverless instance (default 5)
# DATABASE_POOL_MAX=5

# --- Supabase (auth + image storage) -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used to upload/delete images in the "media" storage bucket.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe --------------------------------------------------------------------
# Secret key (sk_live_… in production, sk_test_… for testing). Server-only.
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint https://<site>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Publishable key. Not currently required (Stripe Checkout is hosted by Stripe)
# but kept for future embedded payment elements.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (Resend) -----------------------------------------------------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM="Crieff Angling Club <permits@crieffanglingclub.org.uk>"
# Where customer replies go (e.g. the secretary's club address)
EMAIL_REPLY_TO=
# Fallback for new-booking notifications (the admin Settings value takes priority)
ADMIN_NOTIFICATION_EMAIL=

# --- Security --------------------------------------------------------------------------
# Random string used to hash IP addresses for rate limiting / logs (no raw IPs stored)
IP_HASH_SALT=change-me-to-a-long-random-string
# Protects /api/cron/housekeeping (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=change-me-to-a-long-random-string

# --- Local development only ----------------------------------------------------------------
# Lets the automated browser tests act as a user when Supabase isn't configured.
# Ignored in production builds. Never set this in Vercel.
# E2E_AUTH_BYPASS=1
